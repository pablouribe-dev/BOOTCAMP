<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logging del API Gateway.
  INFO: flujo normal. DEBUG: detalle del paquete com.bank. WARN: llamadas bloqueadas.
-->
<configuration>

    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{40} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="com.bank" level="DEBUG"/>
    <logger name="org.springframework.cloud.gateway" level="INFO"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
