# Copiar a .env y cambiar los valores. El archivo .env NO se sube al repositorio.

# Secreto HS256 compartido por bank-auth-service y bank-api-gateway (minimo 32 bytes).
JWT_SECRET=change-me-to-a-long-random-secret-of-32+bytes

# Administrador inicial: se crea al arrancar si no existe ningun ADMIN.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Zona horaria del negocio (opcional).
BANK_TZ=America/Lima
