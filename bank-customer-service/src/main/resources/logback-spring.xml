<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logging del microservicio de clientes.
  INFO: flujo normal. DEBUG: detalle. WARN: reglas de negocio violadas.
  ERROR: excepciones inesperadas.
-->
<configuration>

    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{40} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="com.bank.customer" level="DEBUG"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
